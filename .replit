modules = ["nodejs-22"]
run = "node apps/api/dist/server.mjs"

[env]
NODE_ENV = "production"
COREPACK_ENABLE_DOWNLOAD_PROMPT = "0"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "corepack pnpm@10.26.1 install --frozen-lockfile && corepack pnpm@10.26.1 build"]
run = ["node", "apps/api/dist/server.mjs"]

[[ports]]
localPort = 3000
externalPort = 80
