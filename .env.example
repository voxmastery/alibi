# Postgres connection string. Local: the docker container from README. Vercel: Neon integration.
DATABASE_URL=
# gstinapi.in key. Absent means SAMPLE mode (R1).
GSTINAPI_KEY=
# Bearer token Vercel Cron presents to /api/jobs/* (R4).
CRON_SECRET=
# Global daily lookup cap across all orgs (R1).
LOOKUP_DAILY_CAP=200
